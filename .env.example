# Server configuration
PORT=3000

# Database
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/igbot?retryWrites=true&w=majority

# Twilio Credentials
# Found in Twilio Console Dashboard (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp Sender
# For WhatsApp Sandbox: whatsapp:+14155238886 (or simply +14155238886)
# For Approved WhatsApp Sender: your approved twilio whatsapp number
TWILIO_PHONE=whatsapp:+14155238886
